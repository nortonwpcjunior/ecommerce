# Copie para .env e preencha. O .env esta no .gitignore.
# Nenhum valor real deve ser versionado.

# API externa de e-mail (Resend). SEM esta variavel o ms_promocoes entra em
# modo DRY-RUN e apenas registra no log o e-mail que teria enviado -- o
# sistema roda inteiro sem conta no Resend.
RESEND_API_KEY=
RESEND_FROM=Promocoes <onboarding@resend.dev>

# Segredo compartilhado entre o Mock de Pagamento e o webhook do MS Pagamento.
# Sem ele, qualquer um que alcance a porta aprova qualquer pedido.
MOCK_WEBHOOK_SECRET=segredo-de-demonstracao

# Broker
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest

# Portas e enderecos dos servicos
GATEWAY_PORTA=8000
PAGAMENTO_PORTA=8003
MOCK_PORTA=8004
ESTOQUE_URL=http://localhost:8002
MOCK_URL=http://localhost:8004

# Segundos entre promocoes geradas
INTERVALO_PROMOCAO=8
